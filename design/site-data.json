          "section": "chassis",
          "label": "Tube Impact Axial Stress",
          "symbol": "\\sigma",
          "equation_tex": "\\sigma = \\frac{F_{\\text{front}}}{2 \\cdot A_{\\text{tube}}} = \\frac{44800\\text{ N}}{2 \\times 123.1\\text{ mm}^2}",
          "inputs": [
            {
